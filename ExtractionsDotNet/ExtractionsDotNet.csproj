<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>ExtractionsDotNet</PackageId>
    <Version>$(ExtractionsVersion)</Version>
    <Title>ExtractionsDotNet</Title>
    <Description>Typed .NET client for the OpenRouter Extractions API: pull typed text, number, date, time, duration, range, and list fields out of text, images, and PDFs with an LLM, with model discovery, dependency injection, and bounded retries.</Description>
    <PackageTags>extraction;llm;ai;structured-output;document-ai;pdf;openrouter;sdk;dotnet</PackageTags>
    <PackageIconSource>$(MSBuildThisFileDirectory)../eng/assets/extractions-icon.png</PackageIconSource>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
