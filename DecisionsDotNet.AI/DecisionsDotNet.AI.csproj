<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The guardrail and workflow helpers build on the experimental conditional layer. -->
    <NoWarn>$(NoWarn);DECISIONS002</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>DecisionsDotNet.AI</PackageId>
    <Version>$(DecisionsVersion)</Version>
    <Title>DecisionsDotNet.AI</Title>
    <Description>Turns any DecisionsDotNet IDecisionsClient into a Microsoft.Extensions.AI AIFunction, so chat clients and Microsoft Agent Framework agents can call a calibrated classifier as a tool. Adds chat guardrails and workflow routing built on calibrated probabilities.</Description>
    <PackageTags>decisions;llm;ai;classification;structured-output;tools;agents;guardrails;microsoft-extensions-ai;agent-framework;openrouter;openai;azure-openai</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DecisionsDotNet\DecisionsDotNet.csproj" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.0.0" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
