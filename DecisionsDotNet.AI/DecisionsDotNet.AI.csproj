<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The guardrail and workflow helpers build on the experimental conditional layer. -->
    <NoWarn>$(NoWarn);DECISIONS002</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>DecisionsDotNet.AI</PackageId>
    <Version>$(DecisionsVersion)</Version>
    <Title>DecisionsDotNet.AI - Decisions as Microsoft.Extensions.AI tools</Title>
    <Description>Exposes any DecisionsDotNet IDecisionsClient (TypeSafe Jev, OpenRouter, or OpenAI Decisions) as a Microsoft.Extensions.AI AIFunction, so chat clients and Microsoft Agent Framework agents can call it as a tool.</Description>
    <PackageTags>Jev;TypeSafe;OpenRouter;OpenAI;AI;decisions;tools;agents;Microsoft.Extensions.AI</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DecisionsDotNet\DecisionsDotNet.csproj" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.0.0" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
