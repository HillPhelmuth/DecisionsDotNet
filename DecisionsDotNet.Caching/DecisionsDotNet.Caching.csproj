<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The cache decorator builds on the experimental pipeline it ships beside. -->
    <NoWarn>$(NoWarn);DECISIONS002</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>DecisionsDotNet.Caching</PackageId>
    <Version>$(DecisionsVersion)</Version>
    <Title>DecisionsDotNet.Caching</Title>
    <Description>Caches DecisionsDotNet evaluations in HybridCache, keyed by a content hash of the state, questions, and model, so the same question about the same input is paid for once. Plugs into the DecisionsClientBuilder pipeline with UseCaching().</Description>
    <PackageTags>decisions;llm;ai;caching;hybridcache;cost;openrouter;openai;azure-openai</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DecisionsDotNet\DecisionsDotNet.csproj" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.0.0" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
