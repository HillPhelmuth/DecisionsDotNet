<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The test doubles build on the experimental conditional layer they ship beside. -->
    <NoWarn>$(NoWarn);DECISIONS002</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>DecisionsDotNet.Testing</PackageId>
    <Version>$(DecisionsVersion)</Version>
    <Title>DecisionsDotNet.Testing</Title>
    <Description>A scripted FakeDecisionsClient and a RecordingDecisionsClient wrapper for DecisionsDotNet, so code that branches on LLM decisions can be unit tested without HTTP stubs or a provider key.</Description>
    <PackageTags>decisions;llm;ai;testing;fakes;test-doubles;unit-testing;xunit</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DecisionsDotNet\DecisionsDotNet.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
