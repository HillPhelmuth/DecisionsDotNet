@using JevDotNet.Demo.Services

<div class="brand">
    <span class="brand-mark" aria-hidden="true">@(InExtractions ? "E" : "D")</span>
    <div><strong>@(InExtractions ? "ExtractionsDotNet" : "DecisionsDotNet")</strong><small>@(InExtractions ? "EXTRACTIONS LAB" : "MODEL SHOWCASE")</small></div>
</div>
<nav aria-label="Main navigation">
    <div class="nav-label">DECISIONS</div>
    <NavLink class="nav-link" href="" Match="NavLinkMatch.All"><span class="nav-symbol">⌂</span> Overview</NavLink>
    @foreach (var scenario in DemoScenarioCatalog.All)
    {
        <NavLink class="nav-link" href="@($"examples/{scenario.Slug}")"><span class="nav-symbol">@scenario.Icon</span> @scenario.Title</NavLink>
    }
    <NavLink class="nav-link" href="bulk-support"><span class="nav-symbol">▦</span> Bulk support triage</NavLink>
    <NavLink class="nav-link" href="jev-as-judge"><span class="nav-symbol">✓</span> Jev as Judge</NavLink>
    <NavLink class="nav-link" href="image-decisions"><span class="nav-symbol">◇</span> Image decisions</NavLink>
    <NavLink class="nav-link" href="image-box"><span class="nav-symbol">▣</span> Find in image</NavLink>
    <NavLink class="nav-link" href="game"><span class="nav-symbol">◎</span> Live chase</NavLink>
    <NavLink class="nav-link" href="pick-a-lane"><span class="nav-symbol">⇈</span> Pick a lane</NavLink>
    <NavLink class="nav-link" href="platform-race"><span class="nav-symbol">↟</span> Platform Race</NavLink>
    <div class="nav-label extraction-nav-label">EXTRACTIONS</div>
    <NavLink class="nav-link extraction-nav-link" href="extractions" Match="NavLinkMatch.All">Extractions Lab</NavLink>
    <NavLink class="nav-link extraction-nav-link" href="extractions/dispatch">Expedition Dispatch</NavLink>
    <NavLink class="nav-link extraction-nav-link" href="extractions/cargo-tag">Cargo Tag</NavLink>
    <NavLink class="nav-link extraction-nav-link" href="extractions/permit">Permit Desk</NavLink>
</nav>

@code {
    [Parameter] public bool InExtractions { get; set; }
}
