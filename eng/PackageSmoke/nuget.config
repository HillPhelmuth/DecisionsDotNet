<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- The three packages must come from the freshly packed files, never from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="DecisionsDotNet" />
      <package pattern="DecisionsDotNet.AI" />
      <package pattern="ExtractionsDotNet" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
