<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>DecisionsDotNet</PackageId>
    <Version>$(DecisionsVersion)</Version>
    <Title>DecisionsDotNet</Title>
    <Description>Ask an LLM yes/no, choice, score, and bounding-box questions from C# and get calibrated probabilities back as typed answers. One IDecisionsClient for the Decisions APIs of OpenRouter, OpenAI, Microsoft Foundry, Azure OpenAI, and TypeSafe AI (Jev), with a fluent request builder, if-statement verbs, batching, dependency injection, and bounded retries.</Description>
    <PackageTags>decisions;llm;ai;classification;structured-output;openrouter;openai;azure-openai;foundry;typesafe;jev;sdk;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <!-- TokenCredential, for Microsoft Entra authentication in the Foundry and Azure OpenAI clients. -->
    <PackageReference Include="Azure.Core" Version="1.64.0" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
